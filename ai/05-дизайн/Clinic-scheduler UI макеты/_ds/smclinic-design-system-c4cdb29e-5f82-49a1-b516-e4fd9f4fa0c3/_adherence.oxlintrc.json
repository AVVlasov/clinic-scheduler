{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/labels/**",
              "components/navigation/**",
              "components/overlays/**",
              "ui_kits/arm-admin/**",
              "ui_kits/arm-doctor/**",
              "ui_kits/arm-operator/**",
              "ui_kits/arm-registrar/**",
              "ui_kits/shared/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Open Sans|JetBrains Mono|Golos Text))/i]",
        "message": "Font not provided by the design system. Available: Open Sans, JetBrains Mono, Golos Text."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|dense|block|icon|iconEnd|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, dense, block, icon, iconEnd."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|attention|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'attention' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommandItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|meta|key|ref|className|style|children)$/]",
        "message": "<CommandItem> doesn't accept that prop. Declared props: id, label, icon, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|width|render|key|ref|className|style|children)$/]",
        "message": "<DataColumn> doesn't accept that prop. Declared props: key, label, align, width, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<DataColumn> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|htmlFor|required|hint|error|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, htmlFor, required, hint, error, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|icon|count|small|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: active, icon, count, small."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|title|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, title, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|pressed|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size, pressed."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plain|bordered|danger)$/]",
        "message": "<IconButton> variant must be one of 'plain' | 'bordered' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<IconButton> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Identifier'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|strong|prefix|key|ref|className|style|children)$/]",
        "message": "<Identifier> doesn't accept that prop. Declared props: value, strong, prefix."
      },
      {
        "selector": "JSXOpeningElement[name.name='InlineNotice'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|icon|actions|children|key|ref|className|style|children)$/]",
        "message": "<InlineNotice> doesn't accept that prop. Declared props: tone, title, icon, actions, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='InlineNotice'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|attention|danger)$/]",
        "message": "<InlineNotice> tone must be one of 'info' | 'success' | 'attention' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:compact|invalid|mono|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: compact, invalid, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kbd'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Kbd> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|kbd|danger|disabled|onSelect|separator|key|ref|className|style|children)$/]",
        "message": "<MenuItem> doesn't accept that prop. Declared props: label, icon, kbd, danger, disabled, onSelect, separator."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|onClose|footer|wide|children|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, onClose, footer, wide, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|actions|padded|children|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, actions, padded, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScheduleSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|patient|note|meta|vip|key|ref|className|style|children)$/]",
        "message": "<ScheduleSlot> doesn't accept that prop. Declared props: state, patient, note, meta, vip."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:compact|shortcut|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: compact, shortcut."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|disabled|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|radius|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: width, height, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlotCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|patient|note|meta|vip|selected|key|ref|className|style|children)$/]",
        "message": "<SlotCell> doesn't accept that prop. Declared props: state, patient, note, meta, vip, selected."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlotCell'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:free|booked|first|waitlist|blocked|break|absent|cancelled)$/]",
        "message": "<SlotCell> state must be one of 'free' | 'booked' | 'first' | 'waitlist' | 'blocked' | 'break' | 'absent' | 'cancelled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecialtyTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:specialty|children|key|ref|className|style|children)$/]",
        "message": "<SpecialtyTag> doesn't accept that prop. Declared props: specialty, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: tone, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|booked|attention|danger|vip)$/]",
        "message": "<StatusBadge> tone must be one of 'neutral' | 'booked' | 'attention' | 'danger' | 'vip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|count|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label, icon, count."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
