{
    "compilerOptions": {
        "lib": [
            "dom",
            "dom.iterable",
            "es2017"
        ],
        "outDir": "./dist/",
        "sourceMap": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "noImplicitAny": false,
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "es2017",
        "jsx": "react-jsx",
        "typeRoots": ["node_modules/@types"],
        "types" : ["node", "webpack-env"],
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": false,
        "isolatedModules": true,
        "noEmit": true
    },
    "include": [
        "src",
        "types.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts",
        "**/*.test.tsx"
    ]
}
